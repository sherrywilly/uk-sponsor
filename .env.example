# AI Provider — set one of these
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Which provider to use: "openai" or "anthropic"
AI_PROVIDER=openai

# OpenAI model (used when AI_PROVIDER=openai)
OPENAI_MODEL=gpt-4o

# Anthropic model (used when AI_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Browser settings
HEADLESS=false
SLOW_MO=400

# Output directory
OUTPUT_DIR=output
